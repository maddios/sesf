-- Purpose: per-event shirt offer and prices. A row means "this shirt type is offered at this event"; price NULL
-- means the default shirt_type.price, a value overrides it for that event only. An event with NO rows offers every
-- shirt type at its default price (the legacy behaviour, so every existing event keeps working unchanged).
-- Written by the admin Events page ("Shirts..."); copied by CloneShowConfiguration when a new event clones another.
-- Prices apply to new shirt orders only: shirt.price keeps the price snapshot of every existing order.
-- Column types match car_show.id, shirt_type.id and shirt_type.price exactly (required by the foreign keys).
-- Rollback: DROP TABLE IF EXISTS `show_shirt_type`;

CREATE TABLE IF NOT EXISTS `show_shirt_type` (
  `show_id` smallint(6) NOT NULL,
  `shirt_type_id` smallint(6) NOT NULL,
  `price` float(6,2) unsigned DEFAULT NULL,
  PRIMARY KEY (`show_id`, `shirt_type_id`),
  KEY `show_shirt_type_shirt_type_id` (`shirt_type_id`),
  CONSTRAINT `show_shirt_type_show_id_fk` FOREIGN KEY (`show_id`) REFERENCES `car_show` (`id`) ON DELETE CASCADE,
  CONSTRAINT `show_shirt_type_shirt_type_id_fk` FOREIGN KEY (`shirt_type_id`) REFERENCES `shirt_type` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
