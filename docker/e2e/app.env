# E2E sandbox environment for the e2eapp service (compose profile "e2e", project sesf-e2e).
#
# This file is BOTH the container environment (env_file in docker-compose.yml) AND bind-mounted
# read-only over /app/.env inside e2eapp, so the repo's own .env is never read by the sandbox.
# Every value here is a fake or a public test value. Never put a real host, key or password here.
#
# Every secret-bearing key the app reads is set explicitly (mostly to empty), so nothing can fall
# back to a real value. Outbound effects are contained:
#   - mail goes to the Mailpit container only (no relay configured there);
#   - the PayPal IPN postback goes to the paypalstub container (self-signed TLS, trusted only here);
#   - Turnstile uses Cloudflare's documented always-pass TEST keys;
#   - Google, Datadog, Vanilla, AWS, Postmark, Resend, Slack keys are empty.

APP_NAME="Southeast Sharkfest"
APP_ENV=local
APP_DEBUG=true
# Fixed fake key for the throwaway sandbox (base64 of "sesf-e2e-sandbox-key-not-secret!").
APP_KEY=base64:c2VzZi1lMmUtc2FuZGJveC1rZXktbm90LXNlY3JldCE=
APP_PREVIOUS_KEYS=
APP_URL=http://localhost:8001
APP_TIMEZONE=EST
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# Never use a config/route/event cache from the shared repo (bootstrap/cache) in the sandbox.
APP_CONFIG_CACHE=/tmp/sesf-e2e-config.php
APP_ROUTES_CACHE=/tmp/sesf-e2e-routes.php
APP_EVENTS_CACHE=/tmp/sesf-e2e-events.php
BCRYPT_ROUNDS=10
PHP_CLI_SERVER_WORKERS=6

LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=
PAPERTRAIL_URL=

DB_CONNECTION=mysql
DB_URL=null
DB_HOST=e2edb
DB_PORT=3306
DB_DATABASE=sesf_e2e
DB_USERNAME=root
DB_PASSWORD=e2e
DB_SOCKET=
DB_TEST_HOST=
DB_TEST_DATABASE=
DB_TEST_USERNAME=
DB_TEST_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
REDIS_URL=null
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
MEMCACHED_PASSWORD=

MAIL_MAILER=smtp
# "null" (env() -> null): an empty MAIL_URL is parsed as a URL and breaks the smtp transport.
MAIL_URL=null
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=registration@sesf.test
MAIL_FROM_NAME="Southeast Sharkfest"
POSTMARK_API_KEY=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=

SESF_EMAIL_DEBUG=false
SESF_DEV_ADDRESS=
SESF_REG_EMAIL=registration@sesf.test
SESF_PAYPAL_EMAIL=seller@sesf.test
SESF_WAIVER_HEALTH_NOTICE_EMAIL=
SESF_FORUM_URL=https://forum.example.test
SESF_SHOP_URL=https://shop.example.test
SESF_EMAIL_LOGO_URL=

# The app only posts IPN verifications to https URLs over verified TLS (IpnVerifier), so the stub
# serves TLS with a throwaway self-signed cert that only this container trusts (docker/e2e/php/e2e.ini).
PAYPAL_IPN_VERIFY_URL=https://paypalstub:9000/cgi-bin/webscr
PAYPAL_SANDBOX=false

VANILLA_CLIENT_ID=
VANILLA_SECRET=

# Cloudflare's documented always-pass TEST keys (https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

GOOGLE_GEOCODE_KEY=
GOOGLE_MAPS_JS_KEY=

DATADOG_RUM_ENABLED=false
DATADOG_LOGS_ENABLED=false
DATADOG_APPLICATION_ID=
DATADOG_CLIENT_TOKEN=
DATADOG_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

# Unset means trust no proxy (the default).
TRUSTED_PROXIES=

# PHP ini overrides for the sandbox only (CA bundle that also trusts the paypalstub cert).
PHP_INI_SCAN_DIR=/usr/local/etc/php/conf.d:/app/docker/e2e/php
