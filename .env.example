APP_NAME="Southeast Sharkfest"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Event dates and times are in Eastern time.
APP_TIMEZONE=EST

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev DB host is set in the local .env (not committed). 127.0.0.1 is a placeholder.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sesf_dev
DB_USERNAME=sesf
DB_PASSWORD=

# session/cache/queue DB drivers need tables that do not exist in the shared
# existing DB yet, so these default to file/sync so the app boots without a DB.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Mailjet SMTP over implicit TLS. Credentials are set in the local .env only.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=registration@bmwsharkfest.org
MAIL_FROM_NAME="Southeast Sharkfest"

# Southeast Sharkfest app settings (config/sesf.php).
# SESF_EMAIL_DEBUG=true redirects every outgoing mail to SESF_DEV_ADDRESS. With debug on and
# no SESF_DEV_ADDRESS, sending fails closed (RuntimeException), so real mail is never sent.
SESF_EMAIL_DEBUG=true
SESF_DEV_ADDRESS=
SESF_REG_EMAIL=registration@bmwsharkfest.org
SESF_PAYPAL_EMAIL=registration@bmwsharkfest.org
SESF_WAIVER_HEALTH_NOTICE_EMAIL=
SESF_FORUM_URL=https://forum.example.org
SESF_SHOP_URL=https://shop.example.org
SESF_EMAIL_LOGO_URL=

# Forum (Vanilla) API client. Secrets are set in the local .env only.
VANILLA_CLIENT_ID=
VANILLA_SECRET=

# Cloudflare Turnstile. Keys are set in the local .env only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Google Maps. Keys are set in the local .env only.
GOOGLE_GEOCODE_KEY=
GOOGLE_MAPS_JS_KEY=

# Datadog. Keys and IDs are set in the local .env only. RUM and log shipping stay off by default.
DATADOG_SITE=us5.datadoghq.com
DATADOG_SERVICE=sesf
DATADOG_RUM_ENABLED=false
DATADOG_APPLICATION_ID=
DATADOG_CLIENT_TOKEN=
DATADOG_LOGS_ENABLED=false
DATADOG_LOGS_LEVEL=info
DATADOG_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dev file store on the host (bind-mounted into the app container by
# docker-compose.yml). Must contain public/images/*, public/packet,
# public/waivers and storage/waivers.
DEV_STORE_DIR=/var/www/sesf-dev-store
